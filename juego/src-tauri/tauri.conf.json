{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Bubble Team Racing",
  "version": "1.0.0",
  "identifier": "com.bubbleteam.racing",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Bubble Team Racing",
        "width": 1280,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "theme": null
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "Aero kart racing with 14 circuits, gaps, shortcuts and fusion turrets",
    "longDescription": "Bubble Team Racing: pick a character, a chassis and one of six finishes, then race fourteen circuits that climb, fall through gaps and split into stacked shortcuts while your partner mans the fusion turret.",
    "copyright": "Bubble Team Racing",
    "publisher": "Bubble Team",
    "homepage": "https://github.com/DaiGeass/bubble-team-racing",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English", "Spanish"],
        "displayLanguageSelector": true
      },
      "wix": {
        "language": ["en-US", "es-ES"]
      }
    }
  }
}